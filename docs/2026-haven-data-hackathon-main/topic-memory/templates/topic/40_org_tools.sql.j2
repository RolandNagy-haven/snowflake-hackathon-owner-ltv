CREATE OR REPLACE PROCEDURE {{ fq }}.{{ n.org_list }}(STATUS VARCHAR, CATEGORY VARCHAR, LIMIT_N NUMBER)
RETURNS VARIANT LANGUAGE SQL EXECUTE AS OWNER AS
$$
DECLARE r VARIANT;
BEGIN
    CALL {{ fq }}.MEM_ORG_LIST('{{ t.id }}', :STATUS, :CATEGORY, :LIMIT_N) INTO :r;
    RETURN r;
END;
$$;

